/* PeopleSoft Agent — iScript for psagent.js
   Record: WEBLIB_PSAGENT   Field: ISCRIPT1   Event: FieldFormula
   Grant the WEBLIB to the users' permission lists (Web Libraries).

   Returns the agent service URL and a token that proves who the user is and
   which agent roles they have. Agent roles are ordinary PeopleSoft roles:
     PSAGENT_USER     chat, tasks, runbooks, troubleshoot processes
     PSAGENT_MONITOR  also set up monitors and see every overnight failure
     PSAGENT_ADMIN    also record tasks and publish runbooks
     PSAGENT_AUDITOR  also the admin dashboard: usage, cost, the audit log
   A user with none of them gets no token, and the widget does not show.

   Token = OPRID.YYYYMMDD.ROLES.HashSHA256(secret|OPRID|YYYYMMDD|ROLES), valid
   for the day; ROLES = e.g. "ADMIN+USER". The secret never leaves the app
   server. Set the same value as PSAGENT_SHARED_SECRET on the agent service.
   HashSHA256 needs PeopleTools 8.54+. */

Constant &AGENT_URL = "https://psagent.example.com";
Constant &AGENT_SECRET = "";

Function JsonEsc(&s As string) Returns string
   Local string &r = Substitute(&s, "\", "\\");
   &r = Substitute(&r, """", "\""");
   &r = Substitute(&r, Char(10), " ");
   &r = Substitute(&r, Char(13), " ");
   &r = Substitute(&r, Char(9), " ");
   Return &r;
End-Function;

Function AgentRoles() Returns string
   Local array of string &names = CreateArray("ADMIN", "AUDITOR", "MONITOR", "USER");
   Local string &roles = "";
   Local integer &i;
   For &i = 1 To &names.Len
      If IsUserInRole("PSAGENT_" | &names [&i]) Then
         If All(&roles) Then
            &roles = &roles | "+";
         End-If;
         &roles = &roles | &names [&i];
      End-If;
   End-For;
   Return &roles;
End-Function;

Function IScript_PSAgentConfig()
   Local string &oprid = %OperatorId;
   Local string &name, &day, &sig;
   Local string &roles = AgentRoles();

   %Response.SetContentType("application/json");
   If None(&roles) Then
      /* no agent role: no token, and the widget stays hidden */
      %Response.Write("{""oprid"":""" | JsonEsc(&oprid) | """,""roles"":[]}");
      Return;
   End-If;

   SQLExec("SELECT OPRDEFNDESC FROM PSOPRDEFN WHERE OPRID = :1", &oprid, &name);
   If None(&name) Then
      &name = &oprid;
   End-If;

   &day = DateTimeToLocalizedString(%Date, "yyyyMMdd");
   &sig = HashSHA256(&AGENT_SECRET | "|" | &oprid | "|" | &day | "|" | &roles);

   %Response.Write("{");
   %Response.Write("""oprid"":""" | JsonEsc(&oprid) | """,");
   %Response.Write("""fullname"":""" | JsonEsc(&name) | """,");
   %Response.Write("""roles"":[""" | Substitute(&roles, "+", """,""") | """],");
   %Response.Write("""agentUrl"":""" | JsonEsc(&AGENT_URL) | """,");
   %Response.Write("""token"":""" | JsonEsc(&oprid | "." | &day | "." | &roles | "." | &sig) | """");
   %Response.Write("}");
End-Function;
