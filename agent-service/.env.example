# PeopleSoft Agent service settings. Copy to .env and fill in.
# .env is read at startup and is never committed (see .gitignore).
# Variables already set in the real environment take precedence.

# --- Required -------------------------------------------------------
# Claude API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Same value as &AGENT_SECRET in the iScript (WEBLIB_PSAGENT).
# Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PSAGENT_SHARED_SECRET=

# PeopleSoft address(es) the browser runs on, comma separated.
# Not needed when the service is reverse-proxied under the PeopleSoft host.
PSAGENT_ALLOWED_ORIGINS=https://your-peoplesoft-host

# --- Optional -------------------------------------------------------
# Who may do what comes from PeopleSoft roles in the iScript's token (see psagent/access.py):
#   PSAGENT_USER (work through the agent as themselves), PSAGENT_MONITOR (also the
#   watcher and anyone's processes), PSAGENT_ADMIN (also record tasks, runbooks,
#   regression tests, anyone's access), PSAGENT_AUDITOR (the admin dashboard, apart).
# Users without any of them don't get the widget. These lists count only in
# development (PSAGENT_DEV_OPRID set); in production they are ignored.
# PSAGENT_TEACHERS=
# PSAGENT_MONITORS=
# PSAGENT_AUDITORS=

# Claude model and effort (low | medium | high | xhigh | max).
PSAGENT_MODEL=claude-opus-5-5
PSAGENT_EFFORT=low

# Folder with task YAML files (recorded tasks are saved here too).
# PSAGENT_TASKS_DIR=
# Folder where published runbooks are saved (default: runbooks/).
# PSAGENT_RUNBOOKS_DIR=

# INFO or DEBUG
PSAGENT_LOG_LEVEL=INFO

# Local testing only: requests without a valid token run as this OPRID
# (with these roles, e.g. ADMIN,MONITOR,USER). Never set on a shared server.
# PSAGENT_DEV_OPRID=
# PSAGENT_DEV_ROLES=

# --- Troubleshooting (optional) ---------------------------------------
# Read-only database access for "why did process N fail?". Leave empty to turn it off.
# Use a SELECT-only account (see README); read-only is also enforced by the service.
# PSAGENT_DB_DSN=dbhost:1521/SERVICE
# PSAGENT_DB_USER=PSAGENT_RO
# PSAGENT_DB_PASSWORD=
# PSAGENT_DB_SCHEMA=SYSADM
# PSAGENT_TROUBLESHOOT_EFFORT=medium

# --- Regression tests (test environments only) ------------------------
# The cases really save data: the feature is off unless this is on.
# PSAGENT_TEST_ENV=on
# PSAGENT_REGRESSION_DIR=
# Unattended runs: a headless browser on this service signs in as this user
# (it needs a PSAGENT role and access to the tasks' pages) and runs the suite.
# Needs: pip install playwright && python -m playwright install chromium
# PSAGENT_TEST_USER=
# PSAGENT_TEST_PASSWORD=
# Values for password fields in the cases (e.g. new users' password).
# PSAGENT_TEST_SECRETS=password=Welcome#2026

# --- Ask the data (curated PS Queries) ---------------------------------
# Answers only from PS Queries whose name starts with this, that each user may run (their query trees).
# PSAGENT_QUERIES=on
# PSAGENT_QUERY_PREFIX=AI_

# --- Excel to CI (Load with a CI) --------------------------------------
# Rows are saved by the browser through WEBLIB_SOAPTOCI as the user; the service
# keeps the CIs' shapes and the loads here. Needs PSAGENT_DB_* for the checks.
# PSAGENT_CI=on
# PSAGENT_CI_DIR=

# --- Audit log and the admin dashboard -------------------------------
# Every Claude call, query, task run and feature event (not the chat text).
# PSAGENT_AUDIT=on
# PSAGENT_AUDIT_DIR=
# PSAGENT_AUDIT_DAYS=90
# Monthly Claude budget in US dollars: email at 80% and 100% (needs SMTP).
# PSAGENT_BUDGET=200
# Budget alerts and the weekly usage email go here (default PSAGENT_ALERT_TO).
# PSAGENT_AUDIT_TO=
# PSAGENT_AUDIT_WEEKLY=Mon 08:00
# Prices if yours differ, USD per million tokens: model=input/output[/cache write/cache read]
# PSAGENT_PRICES=claude-opus-5-5=4/20/5/0.2

# --- Watcher: monitors that run on their own (needs the database) -----
# Monitors are set up in the chat by PSAGENT_MONITOR users and saved here.
# PSAGENT_MONITORS_DIR=
# PSAGENT_WATCH=on
# Investigations of failed processes per day (each is one troubleshooter run).
# PSAGENT_WATCH_MAX_INVESTIGATIONS=20
# Daily summary email to PSAGENT_ALERT_TO at this time (empty = none).
# PSAGENT_WATCH_SUMMARY=07:00
# The PeopleSoft address users sign in on: links in the alert emails, and
# where the service user below signs in.
# PSAGENT_PS_URL=https://ps.example.com/psp/ps/EMPLOYEE/HRMS/
# Service user that downloads posted log files overnight. Give it only
# Process Monitor and Report Manager access. Without it, the message log is used.
# PSAGENT_SVC_USER=PSAGENT_SVC
# PSAGENT_SVC_PASSWORD=
# Alert emails: the analysis and the action needed. Port 587 = STARTTLS, 465 = SSL.
# PSAGENT_SMTP_HOST=smtp.example.com
# PSAGENT_SMTP_PORT=587
# PSAGENT_SMTP_USER=
# PSAGENT_SMTP_PASSWORD=
# PSAGENT_SMTP_FROM=psagent@example.com
# Default recipients (monitors that name nobody) and the daily summary.
# PSAGENT_ALERT_TO=ps-support@example.com
